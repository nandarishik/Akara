{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "/opt/venv/bin/python -m app.workers.decision_engine_worker",
    "cronSchedule": "30 22 * * *",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "_comment": "Schedule docs only. Do not deploy as Railway service 5. Jobs run on cron-intelligence at 22:30/23:30 UTC."
}
