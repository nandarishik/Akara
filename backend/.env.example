# =============================================================
# AKARA Backend — Environment Variables (Phase 2 Day 1)
# Copy to .env and fill in values. NEVER commit .env to git.
# =============================================================

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Transaction-mode pooler (required staging/production — GAP-7)
SUPABASE_POOLER_URL=
# Direct Postgres URI for background import worker (asyncpg)
# Supabase Dashboard → Settings → Database → Connection string (URI)
SUPABASE_DB_URL=
# Dedicated SELECT-only Query Console role (30s timeout / 1000 row cap; no service-role fallback)
QUERY_READONLY_DB_URL=
SUPERADMIN_TOTP_ENCRYPTION_KEY=
REQUIRE_SUDO_TOTP=false
SUPERADMIN_ALERT_EMAIL=
GSTIN_VALIDATION_ENABLED=true
# Storage bucket for async import uploads (default: storage)
SUPABASE_IMPORTS_BUCKET=storage

# ── JWT (must match Supabase Dashboard → Settings → API → JWT Secret)
JWT_SECRET=your-supabase-jwt-secret
JWT_ALGORITHM=HS256

# ── LLM — OpenRouter only (Gemini removed Phase 2)
OPENROUTER_API_KEY=sk-or-v1-...
# Date-pinned model — do not use aliases without date suffix
OPENROUTER_MODEL=openai/gpt-4o-mini-2024-07-18

# ── Razorpay (required staging/production — Day 5 billing)
# Regenerate secret in Dashboard if exposed; never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_MONTHLY_PLAN_ID=
RAZORPAY_PRO_ANNUAL_PLAN_ID=
RAZORPAY_BUSINESS_MONTHLY_PLAN_ID=
RAZORPAY_BUSINESS_ANNUAL_PLAN_ID=

# ── Email — SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=insights@akara.ai
SENDGRID_FROM_NAME=AKARA Insights

# ── WhatsApp — Zaptilo BSP (Day 7)
ZAPTILO_API_KEY=
ZAPTILO_SENDER_NUMBER=
# Set true only after Meta W1–W4 templates are approved
WHATSAPP_SENDS_ENABLED=false

# ── Cloudflare Turnstile (Day 3 signup)
TURNSTILE_SECRET_KEY=

# ── PostHog (Day 13 analytics)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ── Sentry
SENTRY_DSN=

# ── Cron monitoring — healthchecks.io (Day 7)
HEALTHCHECKS_PING_URL=

# ── Company / GST (invoices + legal)
COMPANY_NAME=AKARA Analytics Pvt Ltd
COMPANY_GSTIN=
COMPANY_ADDRESS=
COMPANY_STATE_CODE=
SUPPORT_EMAIL=support@akara.ai
BILLING_EMAIL=billing@akara.ai

# ── Frontend URLs (emails, CORS, redirects)
CUSTOMER_FRONTEND_URL=http://localhost:5173
SUPERADMIN_FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS_RAW=http://localhost:5173

# ── Edge Function → backend auth bypass
BACKEND_SERVICE_KEY=

# ── App
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Live integration tests (Day 6 tenant isolation)
# JWT for a user in tenant A (with sales data) — from browser devtools after login
TEST_TENANT_A_TOKEN=
# JWT for a user in a different tenant B
TEST_TENANT_B_TOKEN=
# API base URL for pytest tests/test_data_isolation.py -m integration
TEST_API_BASE_URL=http://localhost:8000

# ── Observability (Phase 3)
GIT_SHA=dev
SERVICE_NAME=akara-api
OTEL_ENDPOINT=
OTEL_ENABLED=false
STRUCTURED_LOGGING=false

# ── Identity / DPDP (Phase 4)
MAX_CONCURRENT_SESSIONS=3
INVITE_TOKEN_EXPIRY_HOURS=48
ACCOUNT_DELETION_GRACE_DAYS=30
INVITE_EMAIL_TEMPLATE_ID=
EXPORT_READY_EMAIL_TEMPLATE_ID=
ACCOUNT_DELETION_CONFIRM_TEMPLATE_ID=
MAX_SEATS_FREE=5
MAX_SEATS_PRO=10
MAX_SEATS_BUSINESS=25

# ── Café import (Phase 6)
ENABLE_AI_MAPPING=false
AI_MAPPING_MODEL=openai/gpt-4o-mini
AI_MAPPING_TIMEOUT_S=15
IMPORT_BATCH_SIZE=500
IMPORT_MAPPING_TIMEOUT_HOURS=24

# ── Connectors (Phase 7)
CONNECTORS_ENABLED=false
CONNECTOR_MASTER_KEY=
CONNECTOR_TALLY_PUSH_SECRET=
CONNECTOR_SYNC_MAX_CONCURRENT=10
CONNECTOR_SYNC_RATE_LIMIT_RPS=2
AKARA_CONNECT_UPDATE_URL=https://connect.akara.app/updates/

# ── Phase 10 intelligence
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
FORECAST_MIN_DAYS=14
FORECAST_HORIZON=7
ANOMALY_CONTAMINATION=0.1
ANOMALY_MIN_TRAINING_DAYS=30
ALERT_IMMEDIATE_REVENUE_DROP_PCT=50
ALERT_FOOD_COST_THRESHOLD=0.35
WORKER_MAX_RETRIES=3
WORKER_RETRY_BASE_SECONDS=30
ZAPTILO_MORNING_BRIEF_TEMPLATE_ID=
ZAPTILO_ALERT_TEMPLATE_ID=
ZAPTILO_DEBRIEF_SUMMARY_TEMPLATE_ID=

# Phase 11 — decision engine
DECISION_ENGINE_ENABLED=true
DECISION_ENGINE_MAX_RECS_PER_TENANT=10
DECISION_ENGINE_DEDUP_WINDOW_DAYS=30
DECISION_ENGINE_EXPIRY_DAYS=30
OUTCOME_MEASUREMENT_WINDOW_DAYS=14
PLAYBOOK_WEIGHT_ALPHA=0.3
PLAYBOOK_WEIGHT_MIN=0.5
PLAYBOOK_WEIGHT_MAX=2.0
SWIGGY_DEFAULT_COMMISSION_PCT=25
ZOMATO_DEFAULT_COMMISSION_PCT=22
CONFIDENCE_HIGH_THRESHOLD=0.70
CONFIDENCE_MEDIUM_THRESHOLD=0.40
DECISION_ENGINE_MODEL=openai/gpt-4o-mini-2024-07-18
DECISION_ENGINE_MAX_TOKENS_PER_CALL=1000
DECISION_ENGINE_TEMPERATURE=0.3
MAX_EXPECTED_IMPACT_INR=500000

# Legacy Phase 1 vars (ignored by config.py extra=ignore — safe to leave in .env)
# GEMINI_API_KEY=
# WEATHER_API_KEY=
# NEWS_API_KEY=
