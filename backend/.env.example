# =============================================================
# AKARA Backend — Environment Variables (Phase 2 Day 1)
# Copy to .env and fill in values. NEVER commit .env to git.
# =============================================================

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Transaction-mode pooler (required staging/production — GAP-7)
SUPABASE_POOLER_URL=
# Direct Postgres URI for background import worker (asyncpg)
# Supabase Dashboard → Settings → Database → Connection string (URI)
SUPABASE_DB_URL=
# Storage bucket for async import uploads (default: storage)
SUPABASE_IMPORTS_BUCKET=storage

# ── JWT (must match Supabase Dashboard → Settings → API → JWT Secret)
JWT_SECRET=your-supabase-jwt-secret
JWT_ALGORITHM=HS256

# ── LLM — OpenRouter only (Gemini removed Phase 2)
OPENROUTER_API_KEY=sk-or-v1-...
# Date-pinned model — do not use aliases without date suffix
OPENROUTER_MODEL=openai/gpt-4o-mini-2024-07-18

# ── Razorpay (required staging/production — Day 5 billing)
# Regenerate secret in Dashboard if exposed; never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_MONTHLY_PLAN_ID=
RAZORPAY_PRO_ANNUAL_PLAN_ID=
RAZORPAY_BUSINESS_MONTHLY_PLAN_ID=
RAZORPAY_BUSINESS_ANNUAL_PLAN_ID=

# ── Email — SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=insights@akara.ai
SENDGRID_FROM_NAME=AKARA Insights

# ── WhatsApp — Zaptilo BSP (Day 7)
ZAPTILO_API_KEY=
ZAPTILO_SENDER_NUMBER=
# Set true only after Meta W1–W4 templates are approved
WHATSAPP_SENDS_ENABLED=false

# ── Cloudflare Turnstile (Day 3 signup)
TURNSTILE_SECRET_KEY=

# ── PostHog (Day 13 analytics)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ── Sentry
SENTRY_DSN=

# ── Cron monitoring — healthchecks.io (Day 7)
HEALTHCHECKS_PING_URL=

# ── Company / GST (invoices + legal)
COMPANY_NAME=AKARA Analytics Pvt Ltd
COMPANY_GSTIN=
COMPANY_ADDRESS=
COMPANY_STATE_CODE=
SUPPORT_EMAIL=support@akara.ai
BILLING_EMAIL=billing@akara.ai

# ── Frontend URLs (emails, CORS, redirects)
CUSTOMER_FRONTEND_URL=http://localhost:5173
SUPERADMIN_FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS_RAW=http://localhost:5173

# ── Edge Function → backend auth bypass
BACKEND_SERVICE_KEY=

# ── App
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Live integration tests (Day 6 tenant isolation)
# JWT for a user in tenant A (with sales data) — from browser devtools after login
TEST_TENANT_A_TOKEN=
# JWT for a user in a different tenant B
TEST_TENANT_B_TOKEN=
# API base URL for pytest tests/test_data_isolation.py -m integration
TEST_API_BASE_URL=https://akara-production.up.railway.app

# Legacy Phase 1 vars (ignored by config.py extra=ignore — safe to leave in .env)
# GEMINI_API_KEY=
# WEATHER_API_KEY=
# NEWS_API_KEY=
