/**
 * Tests for CopilotPage component including chat functionality, feedback, error states, and slots.
 */
import { render, screen, waitFor, fireEvent, act } from '@testing-library/react';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { vi, describe, it, expect, beforeEach, afterEach } from 'vitest';
import userEvent from '@testing-library/user-event';
import { CopilotPage } from '../CopilotPage';
import { useCopilot } from '@/hooks/useCopilot';
import { useConversations } from '@/hooks/useConversations';

// Mock the hooks
vi.mock('@/hooks/useCopilot');
vi.mock('@/hooks/useConversations');
vi.mock('@/components/ui/toast');

// Mock fetch for feedback API
global.fetch = vi.fn();

const mockUseCopilot = useCopilot as ReturnType<typeof vi.fn>;
const mockUseConversations = useConversations as ReturnType<typeof vi.fn>;
const mockFetch = fetch as ReturnType<typeof vi.fn>;

const createWrapper = () => {
  const queryClient = new QueryClient({
    defaultOptions: {
      queries: {
        retry: false,
      },
    },
  });
  return ({ children }: { children: React.ReactNode }) => (
    <QueryClientProvider client={queryClient}>
      {children}
    </QueryClientProvider>
  );
};

const mockMessages = [
  {
    id: 'msg-1',
    role: 'user' as const,
    content: 'What was the revenue last month?',
    created_at: '2024-01-01T10:00:00Z',
  },
  {
    id: 'msg-2',
    role: 'assistant' as const,
    content: 'The revenue last month was ₹45L across 1,247 orders.',
    created_at: '2024-01-01T10:00:30Z',
  },
];

const mockConversations = [
  {
    id: 'conv-1',
    title: 'Revenue Analysis',
    created_at: '2024-01-01T09:00:00Z',
    updated_at: '2024-01-01T10:00:30Z',
  },
  {
    id: 'conv-2',
    title: 'Product Performance',
    created_at: '2024-01-02T09:00:00Z',
    updated_at: '2024-01-02T10:30:00Z',
  },
];

describe('CopilotPage', () => {
  beforeEach(() => {
    vi.clearAllMocks();
    mockFetch.mockResolvedValue({
      ok: true,
      json: () => Promise.resolve({ message: 'Success' }),
    });
  });

  afterEach(() => {
    vi.restoreAllMocks();
  });

  it('renders empty state when no messages', () => {
    mockUseCopilot.mockReturnValue({
      messages: [],
      isStreaming: false,
      conversationId: null,
      sendMessage: vi.fn(),
      loadConversation: vi.fn(),
      startNewConversation: vi.fn(),
      error: null,
    });

    mockUseConversations.mockReturnValue({
      conversations: mockConversations,
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    render(<CopilotPage />, { wrapper: createWrapper() });

    expect(screen.getByTestId('copilot-empty-state')).toBeInTheDocument();
    expect(screen.getByText('AKARA Copilot')).toBeInTheDocument();
  });

  it('renders messages with navy glass styling', () => {
    mockUseCopilot.mockReturnValue({
      messages: mockMessages,
      isStreaming: false,
      conversationId: 'conv-1',
      sendMessage: vi.fn(),
      loadConversation: vi.fn(),
      startNewConversation: vi.fn(),
      error: null,
    });

    mockUseConversations.mockReturnValue({
      conversations: mockConversations,
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    render(<CopilotPage />, { wrapper: createWrapper() });

    expect(screen.getByText('What was the revenue last month?')).toBeInTheDocument();
    expect(screen.getByText('The revenue last month was ₹45L across 1,247 orders.')).toBeInTheDocument();
  });

  it('displays conversation sidebar with navy glass background', () => {
    mockUseCopilot.mockReturnValue({
      messages: [],
      isStreaming: false,
      conversationId: null,
      sendMessage: vi.fn(),
      loadConversation: vi.fn(),
      startNewConversation: vi.fn(),
      error: null,
    });

    mockUseConversations.mockReturnValue({
      conversations: mockConversations,
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    const { container } = render(<CopilotPage />, { wrapper: createWrapper() });

    expect(screen.getByText('Conversations')).toBeInTheDocument();
    expect(screen.getByText('Revenue Analysis')).toBeInTheDocument();
    expect(screen.getByText('Product Performance')).toBeInTheDocument();

    // Check for navy glass background style
    const sidebar = container.querySelector('[style*="#051B37"]');
    expect(sidebar).toBeInTheDocument();
  });

  it('handles message input and submission', async () => {
    const mockSendMessage = vi.fn();
    
    mockUseCopilot.mockReturnValue({
      messages: [],
      isStreaming: false,
      conversationId: null,
      sendMessage: mockSendMessage,
      loadConversation: vi.fn(),
      startNewConversation: vi.fn(),
      error: null,
    });

    mockUseConversations.mockReturnValue({
      conversations: [],
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    const user = userEvent.setup();
    render(<CopilotPage />, { wrapper: createWrapper() });

    const textarea = screen.getByPlaceholderText('Ask about your revenue, orders, customers...');
    const sendButton = screen.getByRole('button', { name: /send/i });

    await user.type(textarea, 'What were the sales today?');
    await user.click(sendButton);

    expect(mockSendMessage).toHaveBeenCalledWith('What were the sales today?');
  });

  it('handles Enter key for message submission', async () => {
    const mockSendMessage = vi.fn();
    
    mockUseCopilot.mockReturnValue({
      messages: [],
      isStreaming: false,
      conversationId: null,
      sendMessage: mockSendMessage,
      loadConversation: vi.fn(),
      startNewConversation: vi.fn(),
      error: null,
    });

    mockUseConversations.mockReturnValue({
      conversations: [],
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    const user = userEvent.setup();
    render(<CopilotPage />, { wrapper: createWrapper() });

    const textarea = screen.getByPlaceholderText('Ask about your revenue, orders, customers...');
    
    await user.type(textarea, 'Test message');
    await user.keyboard('{Enter}');

    expect(mockSendMessage).toHaveBeenCalledWith('Test message');
  });

  it('handles Shift+Enter for new line without sending', async () => {
    const mockSendMessage = vi.fn();
    
    mockUseCopilot.mockReturnValue({
      messages: [],
      isStreaming: false,
      conversationId: null,
      sendMessage: mockSendMessage,
      loadConversation: vi.fn(),
      startNewConversation: vi.fn(),
      error: null,
    });

    mockUseConversations.mockReturnValue({
      conversations: [],
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    const user = userEvent.setup();
    render(<CopilotPage />, { wrapper: createWrapper() });

    const textarea = screen.getByPlaceholderText('Ask about your revenue, orders, customers...');
    
    await user.type(textarea, 'First line');
    await user.keyboard('{Shift>}{Enter}{/Shift}');
    await user.type(textarea, 'Second line');

    // Should not have sent the message yet
    expect(mockSendMessage).not.toHaveBeenCalled();
    expect(textarea).toHaveValue('First line\nSecond line');
  });

  it('displays streaming indicator when AI is responding', () => {
    mockUseCopilot.mockReturnValue({
      messages: mockMessages,
      isStreaming: true,
      conversationId: 'conv-1',
      sendMessage: vi.fn(),
      loadConversation: vi.fn(),
      startNewConversation: vi.fn(),
      error: null,
    });

    mockUseConversations.mockReturnValue({
      conversations: mockConversations,
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    render(<CopilotPage />, { wrapper: createWrapper() });

    expect(screen.getByText('AI is thinking...')).toBeInTheDocument();
  });

  it('disables input when streaming', () => {
    mockUseCopilot.mockReturnValue({
      messages: mockMessages,
      isStreaming: true,
      conversationId: 'conv-1',
      sendMessage: vi.fn(),
      loadConversation: vi.fn(),
      startNewConversation: vi.fn(),
      error: null,
    });

    mockUseConversations.mockReturnValue({
      conversations: mockConversations,
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    render(<CopilotPage />, { wrapper: createWrapper() });

    const textarea = screen.getByPlaceholderText('Ask about your revenue, orders, customers...');
    const sendButton = screen.getByRole('button', { name: /send/i });

    expect(textarea).toBeDisabled();
    expect(sendButton).toBeDisabled();
  });

  it('displays connection status indicators', () => {
    mockUseCopilot.mockReturnValue({
      messages: [],
      isStreaming: false,
      conversationId: null,
      sendMessage: vi.fn(),
      loadConversation: vi.fn(),
      startNewConversation: vi.fn(),
      error: null,
    });

    mockUseConversations.mockReturnValue({
      conversations: [],
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    render(<CopilotPage />, { wrapper: createWrapper() });

    expect(screen.getByText('Connected')).toBeInTheDocument();
  });

  it('handles 503 error state properly', () => {
    const error503 = new Error('AI is temporarily unavailable (503)');
    
    mockUseCopilot.mockReturnValue({
      messages: [],
      isStreaming: false,
      conversationId: null,
      sendMessage: vi.fn(),
      loadConversation: vi.fn(),
      startNewConversation: vi.fn(),
      error: error503,
    });

    mockUseConversations.mockReturnValue({
      conversations: [],
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    render(<CopilotPage />, { wrapper: createWrapper() });

    expect(screen.getByText('AI is temporarily unavailable')).toBeInTheDocument();
    expect(screen.getByText('Please try again in a few moments')).toBeInTheDocument();
  });

  it('handles 429 rate limit error state', () => {
    const error429 = new Error('AI is temporarily busy (429)');
    
    mockUseCopilot.mockReturnValue({
      messages: [],
      isStreaming: false,
      conversationId: null,
      sendMessage: vi.fn(),
      loadConversation: vi.fn(),
      startNewConversation: vi.fn(),
      error: error429,
    });

    mockUseConversations.mockReturnValue({
      conversations: [],
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    render(<CopilotPage />, { wrapper: createWrapper() });

    expect(screen.getByText('AI is temporarily busy')).toBeInTheDocument();
    expect(screen.getByText('Too many requests - please wait a moment')).toBeInTheDocument();
  });

  it('handles timeout error state', () => {
    const timeoutError = new Error('Response timeout (504)');
    
    mockUseCopilot.mockReturnValue({
      messages: [],
      isStreaming: false,
      conversationId: null,
      sendMessage: vi.fn(),
      loadConversation: vi.fn(),
      startNewConversation: vi.fn(),
      error: timeoutError,
    });

    mockUseConversations.mockReturnValue({
      conversations: [],
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    render(<CopilotPage />, { wrapper: createWrapper() });

    expect(screen.getByText('Response timeout')).toBeInTheDocument();
    expect(screen.getByText('The question is taking too long - try something simpler')).toBeInTheDocument();
  });

  it('renders feedback buttons for assistant messages', () => {
    mockUseCopilot.mockReturnValue({
      messages: mockMessages,
      isStreaming: false,
      conversationId: 'conv-1',
      sendMessage: vi.fn(),
      loadConversation: vi.fn(),
      startNewConversation: vi.fn(),
      error: null,
    });

    mockUseConversations.mockReturnValue({
      conversations: mockConversations,
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    render(<CopilotPage />, { wrapper: createWrapper() });

    // Should have thumbs up and thumbs down buttons for assistant message
    const thumbsUpButtons = screen.getAllByTitle('Helpful');
    const thumbsDownButtons = screen.getAllByTitle('Not helpful');
    
    expect(thumbsUpButtons).toHaveLength(1); // One assistant message
    expect(thumbsDownButtons).toHaveLength(1);
  });

  it('handles positive feedback submission', async () => {
    mockUseCopilot.mockReturnValue({
      messages: mockMessages,
      isStreaming: false,
      conversationId: 'conv-1',
      sendMessage: vi.fn(),
      loadConversation: vi.fn(),
      startNewConversation: vi.fn(),
      error: null,
    });

    mockUseConversations.mockReturnValue({
      conversations: mockConversations,
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    const user = userEvent.setup();
    render(<CopilotPage />, { wrapper: createWrapper() });

    const thumbsUpButton = screen.getByTitle('Helpful');
    await user.click(thumbsUpButton);

    expect(mockFetch).toHaveBeenCalledWith(
      '/api/copilot/feedback',
      expect.objectContaining({
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({
          conversation_id: 'conv-1',
          message_id: 'msg-2',
          rating: 1,
        }),
      })
    );
  });

  it('handles negative feedback submission', async () => {
    mockUseCopilot.mockReturnValue({
      messages: mockMessages,
      isStreaming: false,
      conversationId: 'conv-1',
      sendMessage: vi.fn(),
      loadConversation: vi.fn(),
      startNewConversation: vi.fn(),
      error: null,
    });

    mockUseConversations.mockReturnValue({
      conversations: mockConversations,
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    const user = userEvent.setup();
    render(<CopilotPage />, { wrapper: createWrapper() });

    const thumbsDownButton = screen.getByTitle('Not helpful');
    await user.click(thumbsDownButton);

    expect(mockFetch).toHaveBeenCalledWith(
      '/api/copilot/feedback',
      expect.objectContaining({
        method: 'POST',
        body: JSON.stringify({
          conversation_id: 'conv-1',
          message_id: 'msg-2',
          rating: -1,
        }),
      })
    );
  });

  it('displays data provenance footer for assistant messages', () => {
    mockUseCopilot.mockReturnValue({
      messages: mockMessages,
      isStreaming: false,
      conversationId: 'conv-1',
      sendMessage: vi.fn(),
      loadConversation: vi.fn(),
      startNewConversation: vi.fn(),
      error: null,
    });

    mockUseConversations.mockReturnValue({
      conversations: mockConversations,
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    render(<CopilotPage />, { wrapper: createWrapper() });

    // Should show data provenance info
    expect(screen.getByText('1,247 rows')).toBeInTheDocument();
    expect(screen.getByText('2024-03-15')).toBeInTheDocument();
  });

  it('handles conversation selection', async () => {
    const mockLoadConversation = vi.fn();
    
    mockUseCopilot.mockReturnValue({
      messages: [],
      isStreaming: false,
      conversationId: null,
      sendMessage: vi.fn(),
      loadConversation: mockLoadConversation,
      startNewConversation: vi.fn(),
      error: null,
    });

    mockUseConversations.mockReturnValue({
      conversations: mockConversations,
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    const user = userEvent.setup();
    render(<CopilotPage />, { wrapper: createWrapper() });

    const conversationItem = screen.getByText('Revenue Analysis');
    await user.click(conversationItem);

    expect(mockLoadConversation).toHaveBeenCalledWith('conv-1');
  });

  it('handles new chat creation', async () => {
    const mockStartNewConversation = vi.fn();
    
    mockUseCopilot.mockReturnValue({
      messages: [],
      isStreaming: false,
      conversationId: null,
      sendMessage: vi.fn(),
      loadConversation: vi.fn(),
      startNewConversation: mockStartNewConversation,
      error: null,
    });

    mockUseConversations.mockReturnValue({
      conversations: mockConversations,
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    const user = userEvent.setup();
    render(<CopilotPage />, { wrapper: createWrapper() });

    const newChatButton = screen.getByText('New Chat');
    await user.click(newChatButton);

    expect(mockStartNewConversation).toHaveBeenCalled();
  });

  it('renders ad slot F for AI enhancement', () => {
    mockUseCopilot.mockReturnValue({
      messages: [],
      isStreaming: false,
      conversationId: null,
      sendMessage: vi.fn(),
      loadConversation: vi.fn(),
      startNewConversation: vi.fn(),
      error: null,
    });

    mockUseConversations.mockReturnValue({
      conversations: [],
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    render(<CopilotPage />, { wrapper: createWrapper() });

    expect(screen.getByText('AI Enhancement Available')).toBeInTheDocument();
    expect(screen.getByText('Get advanced analytics with our Pro AI models')).toBeInTheDocument();
    expect(screen.getByText('Upgrade AI')).toBeInTheDocument();
  });

  it('applies proper blue gradient styling to user messages', () => {
    mockUseCopilot.mockReturnValue({
      messages: mockMessages,
      isStreaming: false,
      conversationId: 'conv-1',
      sendMessage: vi.fn(),
      loadConversation: vi.fn(),
      startNewConversation: vi.fn(),
      error: null,
    });

    mockUseConversations.mockReturnValue({
      conversations: mockConversations,
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    const { container } = render(<CopilotPage />, { wrapper: createWrapper() });

    // User messages should have blue gradient styling
    const userMessages = container.querySelectorAll('[style*="linear-gradient"][style*="rgba(66,165,245,0.05)"]');
    expect(userMessages.length).toBeGreaterThan(0);
  });

  it('shows conversation empty state when no conversations exist', () => {
    mockUseCopilot.mockReturnValue({
      messages: [],
      isStreaming: false,
      conversationId: null,
      sendMessage: vi.fn(),
      loadConversation: vi.fn(),
      startNewConversation: vi.fn(),
      error: null,
    });

    mockUseConversations.mockReturnValue({
      conversations: [],
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    render(<CopilotPage />, { wrapper: createWrapper() });

    expect(screen.getByText('Start your first conversation')).toBeInTheDocument();
  });

  it('handles feedback submission failure gracefully', async () => {
    mockFetch.mockResolvedValueOnce({
      ok: false,
      status: 500,
    });

    mockUseCopilot.mockReturnValue({
      messages: mockMessages,
      isStreaming: false,
      conversationId: 'conv-1',
      sendMessage: vi.fn(),
      loadConversation: vi.fn(),
      startNewConversation: vi.fn(),
      error: null,
    });

    mockUseConversations.mockReturnValue({
      conversations: mockConversations,
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    const user = userEvent.setup();
    render(<CopilotPage />, { wrapper: createWrapper() });

    const thumbsUpButton = screen.getByTitle('Helpful');
    await user.click(thumbsUpButton);

    // Should handle the error gracefully without crashing
    expect(mockFetch).toHaveBeenCalled();
  });

  it('disables input when disconnected', () => {
    const disconnectedError = new Error('Network error');
    
    mockUseCopilot.mockReturnValue({
      messages: [],
      isStreaming: false,
      conversationId: null,
      sendMessage: vi.fn(),
      loadConversation: vi.fn(),
      startNewConversation: vi.fn(),
      error: disconnectedError,
    });

    mockUseConversations.mockReturnValue({
      conversations: [],
      createConversation: vi.fn(),
      renameConversation: vi.fn(),
      deleteConversation: vi.fn(),
      refetch: vi.fn(),
    });

    render(<CopilotPage />, { wrapper: createWrapper() });

    const textarea = screen.getByPlaceholderText('Ask about your revenue, orders, customers...');
    expect(textarea).toBeDisabled();
    expect(screen.getByText('Disconnected')).toBeInTheDocument();
  });
});
