/**
 * Tests for DashboardPage component including state transitions, error states, and ad slots.
 */
import { render, screen, waitFor, fireEvent } from '@testing-library/react';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { vi, describe, it, expect, beforeEach } from 'vitest';
import { DashboardPage } from '../DashboardPage';
import { useKPIs } from '@/hooks/useKPIs';

// Mock the hooks
vi.mock('@/hooks/useKPIs');
vi.mock('@/components/ui/toast');

// Mock the chart components since they're complex to test
vi.mock('@/components/dashboard/RevenueTrendChart', () => ({
  RevenueTrendChart: ({ data }: { data: any[] }) => (
    <div data-testid="revenue-chart">
      Revenue Chart with {data.length} data points
    </div>
  ),
}));

vi.mock('@/components/dashboard/ZoneChart', () => ({
  ZoneChart: ({ data }: { data: any[] }) => (
    <div data-testid="zone-chart">
      Zone Chart with {data.length} data points
    </div>
  ),
}));

// Mock AnimatedNumber component
vi.mock('@/components/ui/AnimatedNumber', () => ({
  AnimatedNumber: ({ value }: { value: number }) => (
    <span data-testid="animated-number">{value}</span>
  ),
}));

const mockUseKPIs = useKPIs as ReturnType<typeof vi.fn>;

const createWrapper = () => {
  const queryClient = new QueryClient({
    defaultOptions: {
      queries: {
        retry: false,
      },
    },
  });
  return ({ children }: { children: React.ReactNode }) => (
    <QueryClientProvider client={queryClient}>
      {children}
    </QueryClientProvider>
  );
};

const mockKPIData = {
  summary: {
    total_revenue: 1250000,
    total_orders: 1247,
    unique_parties: 156,
    avg_order_value: 1002.4,
    revenue_change: 125000,
    revenue_change_pct: 11.1,
    orders_change: 89,
    orders_change_pct: 7.7,
    parties_change: 12,
    parties_change_pct: 8.3,
    aov_change: 50.2,
    aov_change_pct: 5.3,
  },
  revenue_trend: [
    { date: '2024-01-01', revenue: 45000 },
    { date: '2024-01-02', revenue: 52000 },
    { date: '2024-01-03', revenue: 48000 },
  ],
  zone_breakdown: [
    { zone: 'North', revenue: 450000 },
    { zone: 'South', revenue: 380000 },
    { zone: 'East', revenue: 420000 },
  ],
  top_products: [
    { product_name: 'Product A', total_revenue: 125000 },
    { product_name: 'Product B', total_revenue: 98000 },
    { product_name: 'Product C', total_revenue: 87000 },
  ],
  route_performance: [
    { route: 'Mumbai Central', order_count: 234, revenue: 456000 },
    { route: 'Delhi NCR', order_count: 189, revenue: 378000 },
  ],
  outstanding_parties: [
    { party_name: 'ABC Traders', outstanding_amount: 45000 },
    { party_name: 'XYZ Corp', outstanding_amount: 32000 },
  ],
  last_import: '2024-01-15T10:30:00Z',
};

describe('DashboardPage', () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it('renders loading state correctly', () => {
    mockUseKPIs.mockReturnValue({
      data: null,
      isLoading: true,
      error: null,
    });

    render(<DashboardPage />, { wrapper: createWrapper() });

    expect(screen.getByText('Mission Control')).toBeInTheDocument();
    // Should show loading skeletons
    expect(screen.getAllByTestId('kpi-skeleton')).toHaveLength(4);
  });

  it('renders empty state when no data', () => {
    mockUseKPIs.mockReturnValue({
      data: null,
      isLoading: false,
      error: null,
    });

    render(<DashboardPage />, { wrapper: createWrapper() });

    expect(screen.getByTestId('dashboard-empty-state')).toBeInTheDocument();
  });

  it('renders error state correctly', () => {
    const mockError = new Error('Failed to fetch KPIs');
    mockUseKPIs.mockReturnValue({
      data: null,
      isLoading: false,
      error: mockError,
    });

    render(<DashboardPage />, { wrapper: createWrapper() });

    expect(screen.getByText('Failed to load dashboard data')).toBeInTheDocument();
    expect(screen.getByText('Failed to fetch KPIs')).toBeInTheDocument();
  });

  it('renders KPI cards with correct data and animations', () => {
    mockUseKPIs.mockReturnValue({
      data: mockKPIData,
      isLoading: false,
      error: null,
    });

    render(<DashboardPage />, { wrapper: createWrapper() });

    // Check KPI cards are rendered
    expect(screen.getByText('Total Revenue')).toBeInTheDocument();
    expect(screen.getByText('Total Orders')).toBeInTheDocument();
    expect(screen.getByText('Unique Parties')).toBeInTheDocument();
    expect(screen.getByText('Avg Order Value')).toBeInTheDocument();

    // Check animated numbers are present
    expect(screen.getAllByTestId('animated-number')).toHaveLength(4);
  });

  it('shows stale data warning when data is old', () => {
    const staleData = {
      ...mockKPIData,
      last_import: '2024-01-01T00:00:00Z', // 8+ days old
    };

    mockUseKPIs.mockReturnValue({
      data: staleData,
      isLoading: false,
      error: null,
    });

    render(<DashboardPage />, { wrapper: createWrapper() });

    expect(screen.getByText(/Data is \d+ days old/)).toBeInTheDocument();
    expect(screen.getByText('Import fresh data to see current metrics')).toBeInTheDocument();
  });

  it('renders charts with proper data', () => {
    mockUseKPIs.mockReturnValue({
      data: mockKPIData,
      isLoading: false,
      error: null,
    });

    render(<DashboardPage />, { wrapper: createWrapper() });

    // Check charts are rendered with data
    expect(screen.getByTestId('revenue-chart')).toHaveTextContent('Revenue Chart with 3 data points');
    expect(screen.getByTestId('zone-chart')).toHaveTextContent('Zone Chart with 3 data points');
  });

  it('renders top products table correctly', () => {
    mockUseKPIs.mockReturnValue({
      data: mockKPIData,
      isLoading: false,
      error: null,
    });

    render(<DashboardPage />, { wrapper: createWrapper() });

    expect(screen.getByText('Top Products')).toBeInTheDocument();
    expect(screen.getByText('Product A')).toBeInTheDocument();
    expect(screen.getByText('Product B')).toBeInTheDocument();
    expect(screen.getByText('Product C')).toBeInTheDocument();
  });

  it('renders route performance with blue gradient bars', () => {
    mockUseKPIs.mockReturnValue({
      data: mockKPIData,
      isLoading: false,
      error: null,
    });

    render(<DashboardPage />, { wrapper: createWrapper() });

    expect(screen.getByText('Route Performance')).toBeInTheDocument();
    expect(screen.getByText('Mumbai Central')).toBeInTheDocument();
    expect(screen.getByText('Delhi NCR')).toBeInTheDocument();
    expect(screen.getByText('View All Routes')).toBeInTheDocument();
  });

  it('renders outstanding parties with navy glass styling', () => {
    mockUseKPIs.mockReturnValue({
      data: mockKPIData,
      isLoading: false,
      error: null,
    });

    render(<DashboardPage />, { wrapper: createWrapper() });

    expect(screen.getByText('Credit Exposure')).toBeInTheDocument();
    expect(screen.getByText('ABC Traders')).toBeInTheDocument();
    expect(screen.getByText('XYZ Corp')).toBeInTheDocument();
    expect(screen.getByText('Manage Credits')).toBeInTheDocument();
  });

  it('renders ad slots D and E', () => {
    mockUseKPIs.mockReturnValue({
      data: mockKPIData,
      isLoading: false,
      error: null,
    });

    render(<DashboardPage />, { wrapper: createWrapper() });

    // Ad Slot D - Featured Integration
    expect(screen.getByText('Featured Integration')).toBeInTheDocument();
    expect(screen.getByText('Connect your ERP system for automated data sync')).toBeInTheDocument();

    // Ad Slot E - Upgrade Prompt
    expect(screen.getByText('Unlock Advanced Analytics')).toBeInTheDocument();
    expect(screen.getByText('Get deeper insights with Pro plan features')).toBeInTheDocument();
  });

  it('handles period selection change', () => {
    mockUseKPIs.mockReturnValue({
      data: mockKPIData,
      isLoading: false,
      error: null,
    });

    render(<DashboardPage />, { wrapper: createWrapper() });

    // Find period selector
    const periodSelector = screen.getByRole('combobox');
    expect(periodSelector).toBeInTheDocument();

    // The period selector should be functional (though we're not testing the actual hook call)
    fireEvent.click(periodSelector);
  });

  it('displays correct date range in header', () => {
    mockUseKPIs.mockReturnValue({
      data: mockKPIData,
      isLoading: false,
      error: null,
    });

    render(<DashboardPage />, { wrapper: createWrapper() });

    // Should show date range in format YYYY-MM-DD → YYYY-MM-DD
    expect(screen.getByText(/\d{4}-\d{2}-\d{2} → \d{4}-\d{2}-\d{2}/)).toBeInTheDocument();
  });

  it('handles empty chart data gracefully', () => {
    const emptyChartsData = {
      ...mockKPIData,
      revenue_trend: [],
      zone_breakdown: [],
    };

    mockUseKPIs.mockReturnValue({
      data: emptyChartsData,
      isLoading: false,
      error: null,
    });

    render(<DashboardPage />, { wrapper: createWrapper() });

    expect(screen.getByText('No revenue data for this period')).toBeInTheDocument();
    expect(screen.getByText('No zone data available')).toBeInTheDocument();
  });

  it('handles empty products data gracefully', () => {
    const emptyProductsData = {
      ...mockKPIData,
      top_products: [],
    };

    mockUseKPIs.mockReturnValue({
      data: emptyProductsData,
      isLoading: false,
      error: null,
    });

    render(<DashboardPage />, { wrapper: createWrapper() });

    expect(screen.getByText('No product data available')).toBeInTheDocument();
  });

  it('does not render route performance section when no data', () => {
    const noRouteData = {
      ...mockKPIData,
      route_performance: [],
    };

    mockUseKPIs.mockReturnValue({
      data: noRouteData,
      isLoading: false,
      error: null,
    });

    render(<DashboardPage />, { wrapper: createWrapper() });

    expect(screen.queryByText('Route Performance')).not.toBeInTheDocument();
  });

  it('does not render outstanding parties section when no data', () => {
    const noOutstandingData = {
      ...mockKPIData,
      outstanding_parties: [],
    };

    mockUseKPIs.mockReturnValue({
      data: noOutstandingData,
      isLoading: false,
      error: null,
    });

    render(<DashboardPage />, { wrapper: createWrapper() });

    expect(screen.queryByText('Credit Exposure')).not.toBeInTheDocument();
  });

  it('applies proper AKARA Blue styling classes', () => {
    mockUseKPIs.mockReturnValue({
      data: mockKPIData,
      isLoading: false,
      error: null,
    });

    const { container } = render(<DashboardPage />, { wrapper: createWrapper() });

    // Check for navy glass styling classes
    const glassCards = container.querySelectorAll('[class*="bg-[rgba(15,52,96"]');
    expect(glassCards.length).toBeGreaterThan(0);

    // Check for blue gradient text
    const gradientTexts = container.querySelectorAll('[style*="linear-gradient"]');
    expect(gradientTexts.length).toBeGreaterThan(0);
  });

  it('shows correct currency formatting', () => {
    mockUseKPIs.mockReturnValue({
      data: mockKPIData,
      isLoading: false,
      error: null,
    });

    render(<DashboardPage />, { wrapper: createWrapper() });

    // Should format large numbers with ₹ symbol and appropriate units (L for lakhs, Cr for crores)
    expect(screen.getByText(/₹.*L/)).toBeInTheDocument(); // Should find some lakh values
  });

  it('handles animation delays for staggered entrances', async () => {
    mockUseKPIs.mockReturnValue({
      data: mockKPIData,
      isLoading: false,
      error: null,
    });

    const { container } = render(<DashboardPage />, { wrapper: createWrapper() });

    // Check for animation delay styles
    const animatedElements = container.querySelectorAll('[style*="animation-delay"]');
    expect(animatedElements.length).toBeGreaterThan(0);
  });

  it('integrates properly with LiquidGlassCard components', () => {
    mockUseKPIs.mockReturnValue({
      data: mockKPIData,
      isLoading: false,
      error: null,
    });

    const { container } = render(<DashboardPage />, { wrapper: createWrapper() });

    // Should use LiquidGlassCard for main sections
    const glassCards = container.querySelectorAll('[class*="backdrop-blur"]');
    expect(glassCards.length).toBeGreaterThan(0);
  });

  it('displays proper loading states for different sections', () => {
    mockUseKPIs.mockReturnValue({
      data: null,
      isLoading: true,
      error: null,
    });

    render(<DashboardPage />, { wrapper: createWrapper() });

    // Should show KPI skeletons
    expect(screen.getAllByTestId('kpi-skeleton')).toHaveLength(4);
    
    // Should show chart skeletons
    expect(screen.getAllByTestId('chart-skeleton')).toHaveLength(2);
  });
});
